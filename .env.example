# ===== Database =====
# Production (Vercel) — PostgreSQL required
# Get from: https://vercel.com/docs/storage/vercel-postgres
# Or: https://supabase.com (free tier) / https://neon.tech (free tier)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ===== Auth / sessions =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="same-value-as-SESSION_SECRET"

# ===== First admin account (used ONLY by the seed script) =====
ADMIN_EMAIL="admin@chadli-location.dz"
ADMIN_PASSWORD="ChangeMe2026!"